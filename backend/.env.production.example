# Configure in the backend hosting provider's secret environment, not source control.
NODE_ENV=production
PORT=3000
# Managed PostgreSQL pooled endpoint; get actual values from your provider.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER-HOST/DATABASE?sslmode=require&connection_limit=5&pool_timeout=20
CORS_ORIGIN=https://YOUR-FRONTEND.vercel.app
ACCESS_TOKEN_SECRET=REPLACE_WITH_A_CRYPTOGRAPHICALLY_RANDOM_SECRET
ACCESS_TOKEN_TTL=15m
ACCESS_TOKEN_ISSUER=helixed-api
ACCESS_TOKEN_AUDIENCE=helixed-web
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=helixed_refresh
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
LOG_LEVEL=info
