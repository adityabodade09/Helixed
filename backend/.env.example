NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:replace-with-local-password@localhost:5433/helixed?schema=public
CORS_ORIGIN=http://localhost:5173
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
ACCESS_TOKEN_ISSUER=helixed-api
ACCESS_TOKEN_AUDIENCE=helixed-web
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=helixed_refresh
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
LOG_LEVEL=info
